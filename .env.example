# Supabase (required)
# Find these in your Supabase project: Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# YouTube Data API v3 (optional)
# When unset, the Learning Videos feature uses a built-in, clearly-labeled demo catalogue
# instead of calling the real API. If you do set this, restrict the key by HTTP referrer in
# the Google Cloud Console before shipping it publicly — it still ships to the browser bundle.
VITE_YOUTUBE_API_KEY=

# AI (optional)
# Roadmap generation, task notes, mind map generation, PDF intelligence, and flashcard
# generation are all powered by Google Gemini (hardcoded to gemini-2.5-flash), proxied through
# the `ai-complete` Supabase Edge Function so the Gemini key never ships to the browser.
# Set VITE_AI_ENABLED=true only after deploying that function and setting its GEMINI_API_KEY
# secret (see docs/ai-workflow.md). This is just a feature flag, not a secret — leave it unset
# to use the deterministic mock AI service instead.
VITE_AI_ENABLED=
