# Supabase (required)
# Find these in your Supabase project: Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# YouTube Data API v3 (optional)
# When unset, the Learning Videos feature uses a built-in, clearly-labeled demo catalogue
# instead of calling the real API.
VITE_YOUTUBE_API_KEY=

# AI (optional)
# Roadmap generation, task notes, mind map generation, PDF intelligence, and flashcard
# generation are all powered by Google Gemini (hardcoded to gemini-2.5-flash). Get a key at
# https://aistudio.google.com/apikey. When unset, these features fall back to a deterministic
# mock AI service instead of calling a real model.
VITE_AI_PROVIDER=gemini
VITE_AI_API_KEY=
